[package]
name = "{{ project_slug }}"
version = "0.1.0"
edition = "2024"
description = "{{ project_description }}"
license = "{{ project_license }}"
repository = "{{ git_repo_url }}"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html
{% if project_type == 'cli' -%}
[[bin]]
name = "{{ project_slug }}"
path = "src/main.rs"
{% elif project_type == 'tui' -%}
[[bin]]
name = "{{ project_slug }}"
path = "src/main.rs"
{% elif project_type == 'library' -%}
[lib]
name = "{{ project_slug }}"
path = "src/lib.rs"
{% endif %}

{% if project_type == 'cli' -%}
[dependencies]
clap = { version = "4", features = ["derive"] }
{% elif project_type == 'tui' -%}
[dependencies]
ratatui = "0.29"
crossterm = "0.28"
{% endif %}