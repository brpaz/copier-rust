# yaml-language-server: $schema=https://json.schemastore.org/taskfile.json
# https://taskfile.dev
version: "3"

vars:
  PROJECT_NAME: "{{ project_name }}"
  REVISION:
    sh: git rev-parse --short=8 HEAD 2>/dev/null || echo "unknown"
  VERSION:
    sh: ver=$(git describe --tags --always --abbrev=8 2>/dev/null) && [ -n "$ver" ] && (echo "$ver" | sed 's/^v//' | sed 's/$/-dev/') || echo "0.0.0-dev"
  BUILD_DATE:
    sh: date -u +%Y-%m-%dT%H:%M:%SZ

env:
  REVISION: "{% raw %}{{.REVISION}}{% endraw %}"
  VERSION: "{% raw %}{{.VERSION}}{% endraw %}"
  BUILD_DATE: "{% raw %}{{.BUILD_DATE}}{% endraw %}"

tasks:
  default:
    cmds:
      - task -l

  info:
    desc: "Display project information"
    cmds:
      - rustc --version
      - cargo --version

  format:
    desc: "Format code using rustfmt"
    cmds:
      - cargo fmt

  build:
    desc: "Build the project"
    cmds:
      - cargo build

  lint:
    desc: "Lint the code"
    cmds:
      - cargo clippy --fix

  test:
    desc: "Run tests"
    cmds:
      - cargo test

  release:
    desc: "Build release version"
    cmds:
      - cargo build --release

  docs:
    desc: "Generate documentation"
    cmds:
      - cargo doc --no-deps