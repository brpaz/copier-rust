{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 20,
  "labels": ["dependencies"],
  "reviewers": ["brpaz"],
  "packageRules": [
    {
      "matchFileNames": ["template/Cargo.toml.jinja"],
      "matchManagers": ["cargo"],
      "automerge": true
    },
    {
      "matchFileNames": ["template/.github/workflows/ci.yml.jinja"],
      "matchManagers": ["github-actions"],
      "automerge": true
    }
  ]
}
